# VoidEngine
# Build outputs (root-level binaries only — must not swallow examples/ dirs)
*.so
*.dll
*.dylib
*.bin
*.exe
/shmup
/demo
/puzzle
/voidengine
/voidengine-test
/shmup-test
/demo-test
/puzzle-test

# Odin artifacts
*.o
*.obj
*.a
*.lib
*.pdb
*.ilk
*.exp

# Assets generated during development
assets/*.wav
assets/*.mp3
assets/*.ogg
assets/*.png
assets/*.jpg
!assets/.gitkeep
# Shmup sprite sheets are versioned so the game runs textured out-of-the-box
!examples/shmup/assets/*.png

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Debug / core dumps
/core
/core.*
*.core

# Temporary files
*.tmp
*.temp
*.log
